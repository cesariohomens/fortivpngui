{
  "name": "fortivpngui",
  "version": "0.4.0",
  "description": "Desktop VPN GUI for FortiGate (openfortivpn) — Tauri + Material UI",
  "homepage": "https://github.com/cesariohomens/fortivpngui",
  "author": {
    "name": "Cesário Mil-Homens",
    "email": "cesario@cesariogarcia.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc --noEmit -p tsconfig.json && vite build",
    "build": "npm run build:renderer",
    "clean": "node scripts/clean-caches.mjs",
    "tauri": "tauri",
    "start": "cargo tauri build --debug && src-tauri/target/debug/fortivpngui",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "dist": "cargo tauri build",
    "dist:deb": "cargo tauri build --bundles deb",
    "dist:rpm": "cargo tauri build --bundles rpm"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
