{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fortivpngui",
  "version": "0.5.0",
  "identifier": "com.cesariogarcia.fortivpngui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FortiVPN GUI",
        "width": 1229,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Desktop VPN GUI for FortiGate (openfortivpn)",
    "longDescription": "Desktop VPN client for FortiGate using openfortivpn — Tauri + React + Material UI",
    "linux": {
      "deb": {
        "depends": ["openfortivpn", "ppp", "sudo", "libsecret-1-0"],
        "postInstallScript": "../resources/packaging/postinst.sh",
        "postRemoveScript": "../resources/packaging/postrm-deb.sh"
      },
      "rpm": {
        "depends": ["openfortivpn", "ppp", "sudo", "libsecret"],
        "postInstallScript": "../resources/packaging/postinst.sh",
        "postRemoveScript": "../resources/packaging/postrm-rpm.sh"
      }
    },
    "resources": {
      "../resources/sudo/fortivpngui.sudoers": "sudo/fortivpngui.sudoers",
      "../resources/icon.svg": "icon.svg"
    }
  },
  "plugins": {}
}
